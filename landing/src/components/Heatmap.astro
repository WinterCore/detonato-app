---
/*
 * Half a year of days, as History draws them: a column a week, a square a
 * day, shaded by how much of it got done. A made-up record, mostly full,
 * ending on a five-week run up to today. It starts dark and fills column by
 * column once it's in view (`.lit`, set by the page's script).
 */
import { noise } from '../lib/glyphs'

const WEEKS = 26
/** Today: the last column's fifth day. Days after it are still to come. */
const TODAY_ROW = 4
const RUN_WEEKS = 5

type Level = 'l0' | 'l1' | 'l2' | 'l3' | 'l4' | 'rest' | 'none'

function levelAt(col: number, row: number): Level {
  if (col === WEEKS - 1 && row > TODAY_ROW) {
    return 'none'
  }
  if (col >= WEEKS - RUN_WEEKS) {
    return 'l4'
  }
  const n = noise(col * 7 + row)
  if (row >= 5 && n > 0.7) {
    return 'rest'
  }
  if (n < 0.55) {
    return 'l4'
  }
  if (n < 0.72) {
    return 'l3'
  }
  if (n < 0.84) {
    return 'l2'
  }
  if (n < 0.93) {
    return 'l1'
  }
  return 'l0'
}

const columns = Array.from({ length: WEEKS }, (_, c) => Array.from({ length: 7 }, (_, r) => ({ key: `${c}-${r}`, level: levelAt(c, r), today: c === WEEKS - 1 && r === TODAY_ROW })))
/** The legend's shades, written out whole so Tailwind finds them. */
const LEGEND = ['bg-lvl-0', 'bg-lvl-1', 'bg-lvl-2', 'bg-lvl-3', 'bg-lvl-4']
---

<figure class="grid gap-4">
  <div class="heat grid grid-flow-col grid-rows-7 gap-[3px] sm:gap-1" style={`grid-template-columns: repeat(${WEEKS}, minmax(0, 1fr))`} data-reveal>
    {
      columns.map((col, c) =>
        col.map((cell) => (
          <span
            class:list={['cell aspect-square rounded-[3px]', cell.level, { 'outline-[1.5px] outline-offset-1 outline-ink': cell.today, invisible: cell.level === 'none' }]}
            style={`--c: ${c}`}
          />
        )),
      )
    }
  </div>
  <figcaption class="flex items-center justify-between font-mono text-[11px] text-ink-3">
    <span>Last 26 weeks</span>
    <span class="flex items-center gap-1.5">
      Less
      {LEGEND.map((shade) => <span class:list={['size-2.5 rounded-[2px]', shade]} />)}
      More
    </span>
  </figcaption>
</figure>
